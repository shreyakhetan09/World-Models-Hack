# Copy to frontend/.env.local and fill in. .env.local is git-ignored.
# Server-side only (used by app/api/reactor-token to mint short-lived JWTs):
REACTOR_API_KEY=
NEXT_PUBLIC_BACKEND_HTTP=http://localhost:8000
NEXT_PUBLIC_BACKEND_WS=ws://localhost:8000/ws
# "static" (free, pans the reference image) or "reactor" (real world model, billed per second)
NEXT_PUBLIC_DEFAULT_WORLD=static
NEXT_PUBLIC_FRAME_INTERVAL_MS=500
